# Configuration de développement pour infra/docker-compose.yml.
# Copier vers backend/.env puis remplacer les trois valeurs A_GENERER.
# Ne jamais écraser le .env existant lors d'une mise à jour.
APP_NAME=ValaDeploy
# Nom Docker réel : préfixe Compose « valadeploy » + réseau « app-network ».
APP_NETWORK=valadeploy_app-network
APP_DOMAIN=localhost
# Port public Traefik ; le backend écoute sur 8000 dans son conteneur.
APP_PORT=8080
ENVIRONMENT=development

POSTGRES_DB=valadeploy
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=valadeploy
POSTGRES_PASSWORD=A_GENERER_MOT_DE_PASSE_POSTGRES

JWT_SECRET_KEY=A_GENERER_SECRET_JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Générer localement (ne pas utiliser littéralement cette valeur) :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=A_GENERER_CLE_FERNET
# Pour POSTGRES_PASSWORD et JWT_SECRET_KEY, générer deux valeurs distinctes :
# python -c "import secrets; print(secrets.token_urlsafe(48))"

# Docker SDK lit facultativement DOCKER_HOST, DOCKER_TLS_VERIFY,
# DOCKER_CERT_PATH via docker.from_env(). Ne pas les définir avec le socket
# Unix monté par le Compose fourni. DOCKER_GID est un ARG du Dockerfile,
# fixé dans infra/docker-compose.yml, pas un paramètre Settings.
# Les variables des applications déployées (VITE_API_URL, DB_URL, etc.)
# sont fournies par projet/composant, pas par ce fichier de la plateforme.


# Security Gate v2
# CRITICAL -> BLOCK par défaut.
BLOCK_ON_CRITICAL=true

# HIGH -> BLOCK par défaut.
# Mettre false pour transformer les HIGH en WARN.
BLOCK_ON_HIGH=true
