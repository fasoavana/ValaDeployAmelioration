{
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/app/venv/bin/python3.10",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/backend/app"
  ],
  "python.analysis.typeCheckingMode": "basic",
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "on",
    "strings": "on"
  },
  "editor.inlineSuggest.enabled": true,
  "editor.action.inlineSuggest.trigger": "onType"
}